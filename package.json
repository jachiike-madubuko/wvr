{
  "name": "weavr",
  "private": true,
  "type": "module",
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:db": "node scripts/test-migrations.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/migrate.mjs --seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:db": "npm run check:env && npm run check:migrations && npm run test:db",
    "verify": "npm run verify:db && npm run typecheck && npm test",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "PLAYWRIGHT_HTML_OPEN=never playwright test --reporter=line --retries=0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@visx/shape": "^4.0.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "gsap": "^3.15.1",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "pg": "^8.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
